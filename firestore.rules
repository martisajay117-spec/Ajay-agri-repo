rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to check ownership of farm
    function isFarmOwner(farmId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/farms/$(farmId)).data.farmerId == request.auth.uid
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    // Farms Collection
    match /farms/{farmId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.farmerId == request.auth.uid || request.resource.data.farmerId == request.auth.uid);

      // Subcollection: fieldHealthHistory
      match /fieldHealthHistory/{historyId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isFarmOwner(farmId) || 
          request.resource.data.farmId == farmId
        );
      }

      // Subcollection: aiRecommendations
      match /aiRecommendations/{recId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isFarmOwner(farmId) || 
          request.resource.data.farmId == farmId
        );
      }

      // Subcollection: cropDiagnostics
      match /cropDiagnostics/{diagId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && (
          isFarmOwner(farmId) || 
          request.resource.data.farmId == farmId
        );
      }
    }
  }
}
