{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profile with role-based details and verification status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "emailOrPhone": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["farmer", "government_partner", "researcher_organization"]
        },
        "country": { "type": "string" },
        "farmSize": { "type": "string" },
        "agencyName": { "type": "string" },
        "department": { "type": "string" },
        "region": { "type": "string" },
        "institutionName": { "type": "string" },
        "researchFocusArea": { "type": "string" },
        "position": { "type": "string" },
        "verificationStatus": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role", "country"]
    },
    "farms": {
      "title": "Farm",
      "description": "Farm entity linked to farmer with soil and field health telemetry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmName": { "type": "string" },
        "location": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "farmSize": { "type": "string" },
        "cropType": { "type": "string" },
        "fieldHealthIndex": { "type": "number" },
        "soilMoisture": { "type": "number" },
        "organicMatter": { "type": "number" },
        "nitrogenLevel": { "type": "number" },
        "soilPh": { "type": "number" },
        "phosphorus": { "type": "number" },
        "potassium": { "type": "number" },
        "predictedYield": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["farmerId", "farmName", "location"]
    },
    "fieldHealthHistory": {
      "title": "FieldHealthHistory",
      "description": "Historical NDVI satellite readings and health score data points",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "farmId": { "type": "string" },
        "date": { "type": "string" },
        "ndvi": { "type": "number" },
        "healthScore": { "type": "number" },
        "satelliteSource": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["farmId", "date", "ndvi"]
    },
    "aiRecommendations": {
      "title": "AiRecommendation",
      "description": "AI-generated regenerative agronomy advisories and action cards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "farmId": { "type": "string" },
        "farmerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["irrigation", "compost", "rotation", "fertilizer", "pest_management"] },
        "status": { "type": "string", "enum": ["pending", "done"] },
        "impact": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["farmId", "title", "description", "status"]
    },
    "cropDiagnostics": {
      "title": "CropDiagnostic",
      "description": "Plant disease classification and diagnostic records with leaf images",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "farmId": { "type": "string" },
        "farmerId": { "type": "string" },
        "imageURL": { "type": "string" },
        "diagnosisResult": { "type": "string" },
        "confidenceScore": { "type": "number" },
        "treatmentRecommendation": { "type": "string" },
        "symptoms": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["farmId", "diagnosisResult", "confidenceScore"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User profile documents"
    },
    "/farms/{farmId}": {
      "schema": { "$ref": "#/entities/farms" },
      "description": "Farmer field documents and telemetry"
    },
    "/farms/{farmId}/fieldHealthHistory/{historyId}": {
      "schema": { "$ref": "#/entities/fieldHealthHistory" },
      "description": "NDVI trend history for a specific farm"
    },
    "/farms/{farmId}/aiRecommendations/{recId}": {
      "schema": { "$ref": "#/entities/aiRecommendations" },
      "description": "AI recommendations for a specific farm"
    },
    "/farms/{farmId}/cropDiagnostics/{diagId}": {
      "schema": { "$ref": "#/entities/cropDiagnostics" },
      "description": "Crop disease diagnostic results"
    }
  }
}
